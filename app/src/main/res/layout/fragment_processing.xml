<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="处理参数"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textViewImageCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="共 0 张图片待处理"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <!-- Crop -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="边缘裁剪"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/textViewCropValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.5%"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBarCropProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="20"
                android:progress="15" />

            <!-- Color shift -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="色彩偏移"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/textViewColorValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="±3%"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBarColorShift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50"
                android:progress="30" />

            <!-- Brightness -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="亮度调整"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/textViewBrightnessValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="±2%"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBarBrightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50"
                android:progress="20" />

            <!-- Noise -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="噪点强度"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/textViewNoiseValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBarNoise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50"
                android:progress="15" />

            <!-- Interference density -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="干扰线密度"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/textViewInterferenceValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30%"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBarInterference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="30" />

            <!-- Watermark -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchWatermark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启用隐形水印"
                android:checked="true"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/editTextWatermark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="水印内容（可选）"
                android:visibility="visible"
                android:layout_marginTop="8dp" />

            <!-- Deep AI mode -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchDeepAi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="深度模式（更强防查重）"
                android:checked="false"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/textViewDeepHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBack"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="返回"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonProcess"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="一键处理"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>
